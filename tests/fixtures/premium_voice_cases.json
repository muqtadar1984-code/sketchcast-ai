{
  "_": "THE premium-voice truth table. One file, two copies, byte-identical: sketchcast-app/src/utils/__tests__/fixtures/premium-voice-cases.json and sketchcast/tests/fixtures/premium_voice_cases.json. Both tests assert the sha256 below, so editing one copy and not the other fails the other repo's suite. Change it only together with migration 0105.",
  "threshold": 100000,
  "paid_tiers": ["pro", "pro_plus", "family", "homeschool", "school"],
  "cases": [
    {
      "name": "comp override exactly at the threshold",
      "max_books": 100000,
