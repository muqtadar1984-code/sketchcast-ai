# Database (default: SQLite in project root)
DATABASE_URL=sqlite:///sketchcast.db

# Upload limits
MAX_UPLOAD_SIZE_MB=200

# Duplicate detection fuzzy match threshold (0-100)
FUZZY_MATCH_THRESHOLD=85

# Image extraction minimums (pixels)
MIN_IMAGE_WIDTH=50
MIN_IMAGE_HEIGHT=50
IMAGE_CONTEXT_WORDS=50

# Pages with fewer characters than this are flagged as low-text
LOW_TEXT_PAGE_THRESHOLD=20

# Persistent SketchCast visual knowledge library
# Binaries live in the private Supabase Storage bucket; metadata lives in
# public.visual_assets. Leave these unset for local-only operation.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VISUAL_LIBRARY_BUCKET=visual-assets
VISUAL_LIBRARY_DIR=storage/visual_library
VISUAL_LIBRARY_MIN_SCORE=0.58

# Optional explicit curriculum context for generation jobs. If unset, the
# library conservatively infers subject from the asset key/prompt and uses
# generic/k12 metadata.
SKETCHCAST_CURRICULUM=generic
SKETCHCAST_SUBJECT=general
SKETCHCAST_GRADE=k12

# Which image model draws an asset (shared/image_models.py).
#   mixed (default)   — gemini-3-pro-image at 2K for an article FIGURE (drawn
#                       once, then shown by every kit, document and translated
#                       channel of the topic), gemini-3.1-flash-image at 1K for
#                       an incidental video SCENE (one-shot, a teacher is
#                       waiting, and it degrades to vector art if it does not
#                       arrive). 2K costs the same 1120 output tokens as 1K on
#                       Pro, so where Pro is used it is used at 2K.
#   premium           — Pro at 2K for BOTH roles. The right setting for an
#                       off-peak catalogue batch, where no teacher is waiting on
#                       the ~1 image/minute Vertex pool that Pro is ~2.8x slower
#                       per unit of. Raise it here, not in code.
#   economy           — gemini-3.1-flash-lite-image at 1K for both.
IMAGE_MODEL_PROFILE=premium
# Per-role overrides; they beat the profile. A model id from the registry, and
# a size that model offers ("1K", "2K", "4K"). The API rejects a lowercase
# size, so it is upper-cased for you; a size the model does not offer is
# clamped down, and a value that is not a size (or not a model) falls back to
# THE PROFILE IN FORCE — never to premium — each with a log line naming what
# was asked for, repeated at most once every IMAGE_MODEL_WARN_INTERVAL_S.
# IMAGE_MODEL_FIGURE=
# IMAGE_MODEL_SCENE=
# IMAGE_SIZE_FIGURE=
# IMAGE_SIZE_SCENE=
# IMAGE_MODEL_WARN_INTERVAL_S=900
# The rollback lever: pins BOTH roles to one model id, and puts the REQUEST
# BODY back with it (2.5-flash-image is sent no imageConfig, exactly as it was
# before this migration). It still works until it retires on 2026-10-02.
# GEMINI_IMAGE_MODEL=
# Longest side, in px, a generated asset is carried at. The model's drawing
# canvas is not this pipeline's working resolution: 2K is free in output tokens
# and is not free in the cache, the base64'd vision request, the published
# library object or the per-frame composite in render.py. Raise it only for a
# print-quality master.
MAX_ASSET_EDGE=1280

# Paid image/vision calls per minute, process-wide (sliding window). Bursts
# from parallel segments tripped 429s on Vertex AND AI Studio; this paces them.
IMAGE_CALLS_PER_MINUTE=15
# Vision (image analysis) requests per minute; cheap and plentiful, so it
# never queues behind image generation.
VISION_CALLS_PER_MINUTE=60
