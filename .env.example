# Database (default: SQLite in project root)
DATABASE_URL=sqlite:///sketchcast.db

# Upload limits
MAX_UPLOAD_SIZE_MB=200

# Duplicate detection fuzzy match threshold (0-100)
FUZZY_MATCH_THRESHOLD=85

# Image extraction minimums (pixels)
MIN_IMAGE_WIDTH=50
MIN_IMAGE_HEIGHT=50
IMAGE_CONTEXT_WORDS=50

# Pages with fewer characters than this are flagged as low-text
LOW_TEXT_PAGE_THRESHOLD=20

# Persistent SketchCast visual knowledge library
# Binaries live in the private Supabase Storage bucket; metadata lives in
# public.visual_assets. Leave these unset for local-only operation.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VISUAL_LIBRARY_BUCKET=visual-assets
VISUAL_LIBRARY_DIR=storage/visual_library
VISUAL_LIBRARY_MIN_SCORE=0.58

# Optional explicit curriculum context for generation jobs. If unset, the
# library conservatively infers subject from the asset key/prompt and uses
# generic/k12 metadata.
SKETCHCAST_CURRICULUM=generic
SKETCHCAST_SUBJECT=general
SKETCHCAST_GRADE=k12

# Paid image/vision calls per minute, process-wide (sliding window). Bursts
# from parallel segments tripped 429s on Vertex AND AI Studio; this paces them.
IMAGE_CALLS_PER_MINUTE=12
