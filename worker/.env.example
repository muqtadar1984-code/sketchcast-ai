# Copy to worker/.env and fill in. NEVER commit the real values.
SUPABASE_URL=https://pblaxsqhjwlqbrwbraxy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-from-supabase-settings-api
ANTHROPIC_API_KEY=your-anthropic-key
WORKER_POLL_SECONDS=5

# Premium TTS (optional — leave everything unset for the free Edge voice).
# Which premium family a PAID account's untouched voice picker (`auto`) gets:
# legacy (none — today), google, elevenlabs. Per-account canary first:
# TTS_PREMIUM_CANARY_OWNERS=<owner uuid>,<owner uuid>  (TTS_PREMIUM_CANARY_PROVIDER=google)
TTS_PREMIUM_PROVIDER=legacy
# Google Cloud TTS is OPT-IN: this flag AND Application Default Credentials
# (GOOGLE_APPLICATION_CREDENTIALS / _JSON, or VERTEX_PROJECT_ID). Credentials
# alone never enable it. Knobs (defaults shown): GOOGLE_TTS_CHAR_CAP=1000000,
# GOOGLE_TTS_RPM=600, GOOGLE_TTS_PARALLEL=4, GOOGLE_TTS_USD_PER_1K_CHIRP=0.030,
# GOOGLE_TTS_USD_PER_1K_CLASSIC=0.004
GOOGLE_TTS_ENABLED=false
# Both must be set for ElevenLabs voices to work; free tier ignores them.
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=your-elevenlabs-key
# Optional cost knobs (defaults shown): ELEVENLABS_CHAR_CAP=500000,
# ELEVENLABS_USD_PER_1K_CHARS=0.085 (turbo on the Pro plan)
# Per-user monthly premium allowance the worker reports against (informational):
# TTS_MONTHLY_CHAR_CAP_PER_USER=2000000

# Dev only: burn a segment-type label into video frames for debugging.
DEBUG_VIDEO=false
