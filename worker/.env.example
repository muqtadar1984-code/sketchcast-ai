# Copy to worker/.env and fill in. NEVER commit the real values.
SUPABASE_URL=https://pblaxsqhjwlqbrwbraxy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-from-supabase-settings-api
ANTHROPIC_API_KEY=your-anthropic-key
WORKER_POLL_SECONDS=5

# Premium TTS (optional — leave unset for the free Edge voice).
# Both must be set for ElevenLabs voices to work; free tier ignores them.
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=your-elevenlabs-key
# Optional cost knobs (defaults shown): ELEVENLABS_CHAR_CAP=500000,
# ELEVENLABS_USD_PER_1K_CHARS=0.30

# Dev only: burn a segment-type label into video frames for debugging.
DEBUG_VIDEO=false
